# FastApi Environment Settings
PROJECT_NAME="TravelPartner AI"
API_V1_STR="/api"
PORT=8000
DEBUG=True

# Optional: Supabase Database Configuration
# Leave blank to use built-in local JSON persistence
SUPABASE_URL=
SUPABASE_KEY=

# Optional: LLM Providers (Gemini or OpenAI)
# Leave blank to use smart built-in generative AI planner engine
GEMINI_API_KEY=
OPENAI_API_KEY=

# CORS Origins (comma separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
